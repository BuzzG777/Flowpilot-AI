{
  "name": "flowpilot-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev -w @flowpilot/server\" \"npm run dev -w @flowpilot/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
